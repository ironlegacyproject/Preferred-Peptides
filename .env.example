# Supabase → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the publishable key (sb_publishable_...) or the legacy anon key. Never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Shown on the site
NEXT_PUBLIC_SHOP_NAME=Preferred Peptides
NEXT_PUBLIC_SHOP_PHONE=(555) 555-0100
# State whose laws govern the Research Use Agreement
NEXT_PUBLIC_SHOP_STATE=Idaho

# ---- Server-only (never prefix these with NEXT_PUBLIC_) ----
# Shown only on a customer's order page after they send an order request
PICKUP_ADDRESS=21318 Hwy 30, Filer, ID

# Daily reorder email (optional). See README "Reorder reminders".
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
REORDER_EMAIL_TO=
REORDER_EMAIL_FROM=Preferred Peptides <orders@yourdomain.com>
